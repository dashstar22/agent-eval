# 凭证值只在进程环境或私有配置中填写，本文件仅声明引用。
AGENTEVAL_PRINTER_BASE_URL=http://127.0.0.1:18090
AGENTEVAL_PRINTER_USERNAME_REF=PRINTER_USERNAME
AGENTEVAL_PRINTER_PASSWORD_REF=PRINTER_PASSWORD
PRINTER_USERNAME=
PRINTER_PASSWORD=
# 真实执行必须显式配置预算；这些是保护上限，不是性能或价格实测。
AGENTEVAL_ALLOW_REAL=false
AGENTEVAL_MAX_AGENT_CALLS=1
AGENTEVAL_CASE_TIMEOUT_SECONDS=360
AGENTEVAL_REQUEST_TIMEOUT_SECONDS=195
AGENTEVAL_OBSERVATION_WAIT_SECONDS=10
# 通用 HTTP 可选 Bearer 凭证引用：
AGENTEVAL_HTTP_BEARER_REF=AGENT_HTTP_API_KEY
AGENT_HTTP_API_KEY=
# 独立MySQL；必须mysql+pymysql且schema以agenteval_开头。
# 从私有进程环境提供完整URL，密码不可提交；不会自动读取本文件。
AGENTEVAL_DATABASE_URL=
# 专用临时测试库，用于额外MySQL约束/API回归：
AGENTEVAL_TEST_DATABASE_URL=
# Judge校准CLI的默认配置；后台运行通过请求中的judge_profile配置。
# 使用环境变量引用，不填写真实密钥后提交。
AGENTEVAL_JUDGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENTEVAL_JUDGE_MODEL=qwen-plus
AGENTEVAL_JUDGE_CREDENTIAL_REF=DASHSCOPE_API_KEY
DASHSCOPE_API_KEY=
